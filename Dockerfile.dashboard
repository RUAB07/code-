FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py ./
COPY templates ./templates

ENV DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 3000

# One worker (SQLite + simple state), several threads, long timeout for slow local LLMs.
CMD ["gunicorn", "-b", "0.0.0.0:3000", "-w", "1", "--threads", "8", "--timeout", "900", "app:app"]
