# --- Database (used by n8n) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL that clients' websites call. In Codespaces use the forwarded URL of port 5678,
# e.g. https://<your-codespace>-5678.app.github.dev/  (keep the trailing slash)
WEBHOOK_URL=http://localhost:5678/
# Any long random string. Do not change it after you have saved credentials in n8n.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# Create it inside n8n: Settings > n8n API > Create an API key. Then restart the dashboard:
#   docker compose up -d dashboard
N8N_API_KEY=

# --- AI model (runs locally in Ollama, no paid API) ---
# llama3.2:3b is small enough for a free Codespace. For better tool use on a bigger machine
# try llama3.1:8b or qwen2.5:7b.
DEFAULT_MODEL=llama3.2:3b

# --- Dashboard login (browser asks for a password; username can be anything) ---
DASHBOARD_PASSWORD=change_me_too
