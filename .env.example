POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/webhook/ai-chat
GENERIC_TIMEZONE=UTC
TZ=UTC

# Cloud mode (recommended for Vercel/public deployments)
OLLAMA_MODE=cloud
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
DEFAULT_MODEL=llama3.1

# Local Docker mode (for Codespaces / VM / self-hosted local dev only):
# OLLAMA_MODE=local
# OLLAMA_BASE_URL=http://ollama:11434
