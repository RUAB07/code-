{
  "name": "AI Workflow Stack",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "dev",
  "runServices": [
    "dev",
    "postgres",
    "n8n",
    "ollama",
    "ollama-pull",
    "dashboard",
    "nginx"
  ],
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [8080, 5678, 11434],
  "portsAttributes": {
    "8080": {
      "label": "AI Agency Agent (dashboard)",
      "onAutoForward": "openBrowser"
    },
    "5678": {
      "label": "n8n",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node"
}
